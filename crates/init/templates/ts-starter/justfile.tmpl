set windows-shell := ["powershell.exe", "-NoProfile", "/c"]

mojang := env_var("USERPROFILE")+"/AppData/Roaming/Minecraft Bedrock/Users/Shared/games/com.mojang"
bp_folder := mojang + "/development_behavior_packs/{{name}}_{{bp_uuid}}"
rp_folder := mojang + "/development_resource_packs/{{name}}_{{rp_uuid}}"
world_folder := mojang + "/minecraftWorlds" 

default:
    npx just --list

bump TYPE:
    cu bump \
    -p ./behavior_packs/pack0/manifest.json \
    -p ./resource_packs/pack1/manifest.json \
    -t {{ TYPE }}
    npx prettier --write .\behavior_packs\pack0\manifest.json
    npx prettier --write .\resource_packs\pack1\manifest.json

build:
    npx tsdown --treeshake --no-unbundle

build-watch:
    npx tsdown --watch

link:
    cu link \
    -i ./behavior_packs/pack0 \
    -o "{{bp_folder}}"
    cu link \
    -i ./resource_packs/pack1 \
    -o "{{rp_folder}}"

unlink:
    cu unlink "{{bp_folder}}"
    cu unlink "{{rp_folder}}"

mcaddon:
    Compress-Archive \
    -Path "./packs/BP", "./packs/RP/" \
    -DestinationPath "./dist/{{name}}.mcaddon" \
    -CompressionLevel "Optimal" \
    -Force

mcworld: 
    cu world \
    -n "{{name}}" \
    -i "{{world_folder}}" \
    -r {{rp_uuid}} \
    -b {{bp_uuid}}
