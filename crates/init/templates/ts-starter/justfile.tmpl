set windows-shell := ["powershell.exe", "-NoProfile", "/c"]

prettier := ".\\node_modules\\.bin\\prettier.cmd"

mojang := env_var("USERPROFILE")+"/AppData/Roaming/Minecraft Bedrock/Users/Shared/games/com.mojang"
mojang_bp := mojang + "/development_behavior_packs/{{name}}_{{bp_uuid}}"
mojang_rp := mojang + "/development_resource_packs/{{name}}_{{rp_uuid}}"
mojang_world := mojang + "/minecraftWorlds" 

init: link
    npm i

bump TYPE:
    cu bump \
    -p ./behavior_packs/pack0/manifest.json \
    -p ./resource_packs/pack1/manifest.json \
    -t {{ TYPE }}
    {{prettier}} --write .\behavior_packs\pack0\manifest.json
    {{prettier}} --write .\resource_packs\pack1\manifest.json

build:
    node esbuild.config.mjs

build-watch:
    node esbuild.config.mjs --watch

link:
    cu link \
    -i ./behavior_packs/pack0 \
    -o "{{mojang_bp}}"
    cu link \
    -i ./resource_packs/pack1 \
    -o "{{mojang_rp}}"

unlink:
    cu unlink "{{mojang_bp}}"
    cu unlink "{{mojang_rp}}"

mcaddon:
    Compress-Archive \
    -Path "./behavior_packs/pack0", "./resource_packs/pack1" \
    -DestinationPath "./dist/{{name}}.mcaddon" \
    -CompressionLevel "Optimal" \
    -Force

mcworld: 
    cu world \
    -n "{{name}}" \
    -i "{{mojang_world}}" \
    -r {{rp_uuid}} \
    -b {{bp_uuid}}
