set windows-shell := ["powershell.exe", "-NoProfile", "/c"]

biome := "./node_modules/.bin/biome.cmd"
tsdown := "./node_modules/.bin/tsdown.cmd"
just := "./node_modules/.bin/just.cmd"

mojang := env_var("USERPROFILE")+"/AppData/Roaming/Minecraft Bedrock/Users/Shared/games/com.mojang"
bp_folder := mojang + "/development_behavior_packs/{{name}}_{{bp_uuid}}"
rp_folder := mojang + "/development_resource_packs/{{name}}_{{rp_uuid}}"
world_folder := mojang + "/minecraftWorlds" 

default:
    {{just}} --list

bump TYPE:
    cu bump -p ./packs/RP/manifest.json -p ./packs/BP/manifest.json -t {{ TYPE }}
    {{biome}} --write "./packs/{RP,BP}/manifest.json"

build:
    {{tsdown}} --treeshake --no-unbundle

build-watch:
    {{tsdown}} --watch

link:
    cu link -i ./packs/BP -o "{{bp_folder}}"
    cu link -i ./packs/RP -o "{{rp_folder}}"

unlink:
    cu unlink "{{bp_folder}}"
    cu unlink "{{rp_folder}}"

mcaddon:
    mkdir ./dist/addon/
    Compress-Archive "./packs/BP","./packs/RP/" "./dist/addon/{{name}}.mcaddon" -f

mcworld: 
    cu world -n "{{name}}" -i "{{world_folder}}" \
    -r {{rp_uuid}} \
    -b {{bp_uuid}}

clean:
    rm -r -Force ./dist/*
    gci -r -di "generated" | % { gci $_.FullName | rm -r -fo }

lint:
  {{biome}} check .

validate:
    mct validate -i ./packs/ -o ./dist/validate/
